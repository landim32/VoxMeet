<Window x:Class="VoxMeet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxMeet Settings"
        Width="480" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        Foreground="White">

    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#FF313244" />
            <Setter Property="Foreground" Value="#FFCDD6F4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Custom ScrollBar Thumb -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#FF45475A" CornerRadius="3"
                                Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Vertical ScrollBar -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="0,2,2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#FF161622" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply custom scrollbar to all ScrollViewers -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DarkScrollBar}"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#FF1E1E2E" BorderThickness="0" Margin="10,10,10,0">

            <!-- ==================== TAB: General ==================== -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF1E1E2E">
                    <StackPanel Margin="16">
                        <!-- OpenAI API Key -->
                        <TextBlock Text="OpenAI API Key" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtApiKey"
                                 Height="32" Padding="6,4"
                                 Background="#FF313244" Foreground="White" CaretBrush="White"
                                 BorderBrush="#FF45475A" BorderThickness="1" />

                        <!-- Audio Mode -->
                        <TextBlock Text="Audio Source" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,6" />
                        <ComboBox x:Name="CmbAudioMode" Height="32" Padding="6,4"
                                  SelectionChanged="CmbAudioMode_SelectionChanged">
                            <ComboBoxItem Content="System Audio (Loopback)" Tag="loopback" />
                            <ComboBoxItem Content="Microphone" Tag="microphone" />
                        </ComboBox>

                        <!-- Audio Device -->
                        <TextBlock Text="Audio Device" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,6" />
                        <ComboBox x:Name="CmbDevice" Height="32" Padding="6,4" DisplayMemberPath="Name" />

                        <!-- Buffer Seconds -->
                        <TextBlock Text="Buffer Duration (seconds)" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,6" />
                        <ComboBox x:Name="CmbBufferSeconds" Height="32" Padding="6,4">
                            <ComboBoxItem Content="3" Tag="3" />
                            <ComboBoxItem Content="5" Tag="5" IsSelected="True" />
                            <ComboBoxItem Content="8" Tag="8" />
                            <ComboBoxItem Content="10" Tag="10" />
                        </ComboBox>

                        <!-- Whisper Model -->
                        <TextBlock Text="Whisper Model" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,6" />
                        <ComboBox x:Name="CmbWhisperModel" Height="32" Padding="6,4">
                            <ComboBoxItem Content="whisper-1" Tag="whisper-1" IsSelected="True" />
                            <ComboBoxItem Content="gpt-4o-transcribe" Tag="gpt-4o-transcribe" />
                            <ComboBoxItem Content="gpt-4o-mini-transcribe" Tag="gpt-4o-mini-transcribe" />
                        </ComboBox>

                        <!-- Silence Detection -->
                        <Separator Background="#FF45475A" Margin="0,16,0,0" />
                        <CheckBox x:Name="ChkSilenceDetection"
                                  Content="Send to AI on silence (when no '?' detected)"
                                  Foreground="White" Margin="0,16,0,0" />

                        <!-- Simulation Mode -->
                        <CheckBox x:Name="ChkSimulationMode"
                                  Content="Simulation Mode (no API/audio required)"
                                  Foreground="White" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB: Appearance ==================== -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF1E1E2E">
                    <StackPanel Margin="16">

                        <!-- Background Color -->
                        <TextBlock Text="Background Color" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,16">
                            <Border x:Name="PreviewBgColor" Width="32" Height="32"
                                    Background="#FF1E1E2E" CornerRadius="4" BorderBrush="#FF45475A"
                                    BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtBgColor" Height="32" Padding="6,4"
                                     Background="#FF313244" Foreground="White" CaretBrush="White"
                                     BorderBrush="#FF45475A" BorderThickness="1"
                                     TextChanged="TxtBgColor_TextChanged" />
                        </DockPanel>

                        <!-- Background Opacity -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Background Opacity" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Left" />
                            <TextBlock x:Name="TxtOpacityValue" Text="80%" Foreground="#AAA6ADC8"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SliderOpacity" Minimum="10" Maximum="100" Value="80"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                ValueChanged="SliderOpacity_ValueChanged" Margin="0,0,0,16" />

                        <!-- Separator -->
                        <Separator Background="#FF45475A" Margin="0,0,0,16" />

                        <!-- Transcription (Question) -->
                        <TextBlock Text="TRANSCRIPTION" FontWeight="Bold" Foreground="#AAA6ADC8" FontSize="11" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Font Size" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Left" />
                            <TextBlock x:Name="TxtTranscriptionFontValue" Text="17" Foreground="#AAA6ADC8"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SliderTranscriptionFont" Minimum="10" Maximum="36" Value="17"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="SliderTranscriptionFont_ValueChanged" Margin="0,0,0,8" />

                        <TextBlock Text="Font Color" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,16">
                            <Border x:Name="PreviewTranscriptionColor" Width="32" Height="32"
                                    Background="#FFEEEEF0" CornerRadius="4" BorderBrush="#FF45475A"
                                    BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtTranscriptionColor" Height="32" Padding="6,4"
                                     Background="#FF313244" Foreground="White" CaretBrush="White"
                                     BorderBrush="#FF45475A" BorderThickness="1"
                                     TextChanged="TxtTranscriptionColor_TextChanged" />
                        </DockPanel>

                        <!-- Separator -->
                        <Separator Background="#FF45475A" Margin="0,0,0,16" />

                        <!-- Answer -->
                        <TextBlock Text="ANSWER" FontWeight="Bold" Foreground="#AAA6ADC8" FontSize="11" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Font Size" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Left" />
                            <TextBlock x:Name="TxtAnswerFontValue" Text="19" Foreground="#AAA6ADC8"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SliderAnswerFont" Minimum="10" Maximum="36" Value="19"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="SliderAnswerFont_ValueChanged" Margin="0,0,0,8" />

                        <TextBlock Text="Font Color" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,16">
                            <Border x:Name="PreviewAnswerColor" Width="32" Height="32"
                                    Background="#FF94E2D5" CornerRadius="4" BorderBrush="#FF45475A"
                                    BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtAnswerColor" Height="32" Padding="6,4"
                                     Background="#FF313244" Foreground="White" CaretBrush="White"
                                     BorderBrush="#FF45475A" BorderThickness="1"
                                     TextChanged="TxtAnswerColor_TextChanged" />
                        </DockPanel>

                        <!-- Separator -->
                        <Separator Background="#FF45475A" Margin="0,0,0,16" />

                        <!-- Log -->
                        <TextBlock Text="LOG" FontWeight="Bold" Foreground="#AAA6ADC8" FontSize="11" Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkShowLog" Content="Show log messages"
                                  Foreground="White" Margin="0,0,0,10" IsChecked="True" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Font Size" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Left" />
                            <TextBlock x:Name="TxtLogFontValue" Text="11" Foreground="#AAA6ADC8"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SliderLogFont" Minimum="8" Maximum="24" Value="11"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="SliderLogFont_ValueChanged" Margin="0,0,0,8" />

                        <TextBlock Text="Font Color" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,8">
                            <Border x:Name="PreviewLogColor" Width="32" Height="32"
                                    Background="#FF6C7086" CornerRadius="4" BorderBrush="#FF45475A"
                                    BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtLogColor" Height="32" Padding="6,4"
                                     Background="#FF313244" Foreground="White" CaretBrush="White"
                                     BorderBrush="#FF45475A" BorderThickness="1"
                                     TextChanged="TxtLogColor_TextChanged" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ==================== TAB: Prompt ==================== -->
            <TabItem Header="Prompt">
                <Grid Background="#FF1E1E2E" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="System Prompt" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtSystemPrompt"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8"
                             Background="#FF313244"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#FF45475A"
                             BorderThickness="1"
                             FontSize="12" />
                    <TextBlock Grid.Row="2"
                               Text="This prompt is sent as a system message to ChatGPT before each question."
                               Foreground="#886C7086" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,10,14">
            <Button Content="Save" Click="BtnSave_Click"
                    Width="90" Height="34" Margin="0,0,10,0"
                    Background="#CC4CAF50" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" FontSize="14" Cursor="Hand" />
            <Button Content="Cancel" Click="BtnCancel_Click"
                    Width="90" Height="34"
                    Background="#CC6C7086" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" FontSize="14" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
